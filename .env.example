# Copie ce fichier en .env et renseigne tes cles (le .env est git-ignore).
# Seules les cles des backends que tu utilises sont necessaires.

# Cloud Anthropic (backend --dict-backend claude, ou --backend claude)
ANTHROPIC_API_KEY=sk-ant-...

# Cloud Google Gemini (backend --dict-backend gemini, ou --backend gemini)
GEMINI_API_KEY=...

# LLM local (Ollama / LM Studio) — optionnel, defaut http://localhost:11434/v1
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
